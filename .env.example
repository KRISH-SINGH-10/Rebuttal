# AI model. Gemini (free tier) is the default: key from aistudio.google.com.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash-lite).
GEMINI_MODEL=
# Optional: AI_PROVIDER=claude to use Claude instead, with APP_ANTHROPIC_API_KEY.
AI_PROVIDER=
APP_ANTHROPIC_API_KEY=

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty, or set PAYPAL_MODE=mock, to run against the built-in simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same sandbox app, needed to receive dispute webhooks.
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=

# Where saved investigations live (default cache/investigations).
REBUTTAL_CACHE_DIR=

# Development only: replay a scripted model instead of calling the AI.
REBUTTAL_SCRIPTED_MODEL=
