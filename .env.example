# Claude (required for real analysis)
APP_ANTHROPIC_API_KEY=

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty, or set PAYPAL_MODE=mock, to run against the built-in simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same sandbox app, needed to receive dispute webhooks.
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=

# Development only: replay a scripted model instead of calling Claude.
REBUTTAL_SCRIPTED_MODEL=
